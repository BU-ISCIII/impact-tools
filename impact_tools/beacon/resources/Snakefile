#ftype: python
# Bundled from: https://github.com/Genome-of-Europe/pgx_pilot
# Upstream commit: 2026-06-22 "Set default AF cutoff to 0.0"
#
# Local divergences from upstream:
#   - select_regions: removed -S {sample_id_file} (per-sample selection).
#     Input is the full multisample joint VCF for the batch; -R (regions BED)
#     is the only selection applied.
#   - local_resources.ref_fasta: used instead of downloading the reference.
#   - download_reference_source / download_selection_bed: kept but only fire
#     when the local path is absent; nodes must not access the internet.
#   - output_prefix driven by batch_id, not sample_id.
#
# DO NOT introduce per-sample subsetting here. Allele frequencies, HWE,
# missingness and stratified statistics must be computed over all samples
# in the batch simultaneously.

configfile: "config.yaml"

import os, sys

# --- Config Validation ---
if not config.get("input_vcf") or not os.path.exists(config["input_vcf"]):
    sys.exit(f"ERROR: input_vcf not found: '{config.get('input_vcf')}'.")

if not config.get("regions_bed"):
    sys.exit("ERROR: 'regions_bed' is required in config.yaml.")

# --- Helper Functions ---
def get_ref_fasta(wildcards=None):
    return (
        config.get("local_resources", {}).get("ref_fasta")
        or "resources/GRCh38.fa"
    )

# --- Main Rule ---
rule all:
    input:
        expand("results/{prefix}.sites.all.vcf.gz",  prefix=config.get("output_prefix", "batch")),
        expand("results/{prefix}.sites.pass.vcf.gz", prefix=config.get("output_prefix", "batch")),
        expand("results/intermediate/{prefix}.full_sample_data.vcf.gz", prefix=config.get("output_prefix", "batch"))

# --- Resources & Common Steps ---
rule index_vcf:
    input: "{filename}.vcf.gz"
    output: "{filename}.vcf.gz.tbi"
    shell:
        "tabix -pvcf {input}"

rule prepare_reference:
    input:
        src=lambda w: (
            config.get("local_resources", {}).get("ref_fasta")
            or "resources/downloaded_GRCh38.fa.gz"
        )
    output:
        fasta="resources/GRCh38.fa",
        dct="resources/GRCh38.dict"
    shell:
        """
        if [[ "{input.src}" == *.gz ]]; then
            gunzip -c {input.src} > {output.fasta}
        else
            ln -sf {input.src} {output.fasta}
        fi
        samtools faidx {output.fasta}
        samtools dict {output.fasta} > {output.dct}
        """

rule download_reference_source:
    output: "resources/downloaded_GRCh38.fa.gz"
    params:
        url=lambda w: config.get("resources", {}).get("ref_fasta_url", "")
    shell:
        """
        if [ -z "{params.url}" ]; then
            echo "ERROR: resources.ref_fasta_url is not set and local_resources.ref_fasta was not available." >&2
            exit 1
        fi

        echo "WARNING: downloading reference from internet. Compute nodes should use local_resources.ref_fasta." >&2
        wget --tries=3 -O {output} {params.url}
        """

# --- Pipeline Rules ---
rule select_regions:
    input:
        vcf=lambda w: config["input_vcf"],
    output:
        "results/temp/01_selected.vcf.gz"
    params:
        bed_path=lambda w: (
            "resources/selection_targets.bed"
            if config.get("regions_bed", "").startswith(("http", "ftp"))
            else config.get("regions_bed", "")
        )
    shell:
        """
        bcftools view \
            -I \
            -R {params.bed_path} \
            -Ou \
            {input.vcf} \
        | bcftools view \
            -e 'ALT="*"' \
            -Oz \
            -o {output}

        tabix -p vcf {output}
        """

rule normalize_and_split:
    input:
        vcf="results/temp/01_selected.vcf.gz",
        ref=lambda w: get_ref_fasta()
    output: "results/temp/02_normalized.vcf.gz"
    shell:
        """
        bcftools norm --force -m -any -f {input.ref} -Ou {input.vcf} | \
        bcftools view -e 'ALT="."' -Ou | \
        bcftools +setGT -Ou -- -t q -i 'GT~"[2-9]"' -n . | \
        bcftools view -O z -o {output}
        tabix -p vcf {output}
        """

rule download_selection_bed:
    output: "resources/selection_targets.bed"
    params: url=config.get("regions_bed")
    shell:
        """
        echo "WARNING: downloading targets BED from internet." >&2
        wget --tries=3 -O {output} {params.url}
        """

# --- QC Workflow ---

rule generate_groups_raw:
    input: samples=config["sample_info"]
    output: groups="results/temp/groups_raw.txt"
    params: suffix="raw"
    shell:
        "python scripts/generate_groups.py {input.samples} {output.groups} --suffix {params.suffix}"

rule annotate_raw_vcf:
    input:
        vcf="results/temp/02_normalized.vcf.gz",
        groups="results/temp/groups_raw.txt"
    output: vcf="results/temp/03_raw_stats.vcf.gz"
    shell:
        """
        bcftools +fill-tags {input.vcf} -Ou -- \
            -S {input.groups} \
            -t AC,AN,AF,AC_Het,AC_Hom,AC_Hemi,MAF,HWE,NS,F_MISSING,ExcHet | \
        bcftools view -O z -o {output.vcf}
        tabix -p vcf {output.vcf}
        """

rule genotype_masking:
    input: "results/temp/03_raw_stats.vcf.gz"
    output: "results/temp/04_masked.vcf.gz"
    params:
        min_gq=config["qc_thresholds"]["min_gq"],
        min_dp=config["qc_thresholds"]["min_dp"],
        min_ab=config["qc_thresholds"]["ab_ratio"],
        max_ab=1 - config["qc_thresholds"]["ab_ratio"]
    shell:
        """
        if bcftools view -h {input} | grep -q '##FORMAT=<ID=GQ'; then
            bcftools +setGT {input} -O z -o {output} -- \
                -t q -n . \
                -i 'FMT/GQ < {params.min_gq} | FMT/DP < {params.min_dp} | \
                    (GT="het" & (FMT/AD[*:0] + FMT/AD[*:1]) > 0 & \
                    ((FMT/AD[*:1])/(FMT/AD[*:0]+FMT/AD[*:1]) < {params.min_ab} | \
                     (FMT/AD[*:1])/(FMT/AD[*:0]+FMT/AD[*:1]) > {params.max_ab}))'
        else
            cp {input} {output}
        fi
        tabix -p vcf {output}
        """

rule generate_groups_final:
    input: samples=config["sample_info"]
    output: groups="results/temp/groups_final.txt"
    params: suffix=""
    shell:
        "python scripts/generate_groups.py {input.samples} {output.groups}"

rule annotate_final_vcf:
    input:
        vcf="results/temp/04_masked.vcf.gz",
        groups="results/temp/groups_final.txt"
    output: vcf="results/temp/05_final_stats.vcf.gz"
    shell:
        """
        bcftools +fill-tags {input.vcf} -Ou -- \
            -S {input.groups} \
            -t AC,AN,AF,AC_Het,AC_Hom,AC_Hemi,MAF,HWE,NS,F_MISSING,ExcHet | \
        bcftools view -O z -o {output.vcf}
        tabix -p vcf {output.vcf}
        """

rule variant_qc_tagging:
    input: "results/temp/05_final_stats.vcf.gz"
    output: "results/intermediate/{prefix}.full_sample_data.vcf.gz"
    params:
        qual=config["qc_thresholds"]["qual"],
        qd=config["qc_thresholds"]["qd"],
        mq=config["qc_thresholds"]["mq"],
        fs=config["qc_thresholds"]["fs"],
        readpos=config["qc_thresholds"]["readpos"],
        hwe=config["qc_thresholds"]["hwe"],
        maf=config["qc_thresholds"]["maf"],
        max_missing=config["qc_thresholds"]["max_missing"],
        min_dp=config["qc_thresholds"]["min_dp"],
        min_gq=config["qc_thresholds"]["min_gq"],
        ab_ratio=config["qc_thresholds"]["ab_ratio"]
    shell:
        """
        python scripts/tag_variant_qc.py {input} {output} \
            --qual {params.qual} \
            --qd {params.qd} \
            --mq {params.mq} \
            --fs {params.fs} \
            --readpos {params.readpos} \
            --hwe {params.hwe} \
            --maf {params.maf} \
            --max_missing {params.max_missing} \
            --min_dp {params.min_dp} \
            --min_gq {params.min_gq} \
            --ab_ratio {params.ab_ratio}
        tabix -p vcf {output}
        """

rule create_sites_vcf:
    input: "results/intermediate/{prefix}.full_sample_data.vcf.gz"
    output:
        all_sites="results/{prefix}.sites.all.vcf.gz",
        pass_sites="results/{prefix}.sites.pass.vcf.gz"
    shell:
        """
        bcftools view -G -O z -o {output.all_sites} {input}
        tabix -p vcf {output.all_sites}

        bcftools view -G -i 'INFO/QC_STATUS="PASS"' {input} -O z -o {output.pass_sites}
        tabix -p vcf {output.pass_sites}
        """
